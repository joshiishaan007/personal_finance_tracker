# Single Next.js app — one deployment (Vercel). Same-origin: no CLIENT_URL/SERVER_URL/PORT.
MONGODB_URI=mongodb+srv://...
JWT_SECRET=replace-with-a-secret-at-least-32-characters-long
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
# Base URL of the deployment; used to build the OAuth callback + post-login redirect.
# Local: http://localhost:3000  ·  Prod: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional
# SENTRY_DSN=
