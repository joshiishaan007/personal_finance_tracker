# Single Next.js app — one deployment (Vercel). Same-origin: no CLIENT_URL/SERVER_URL/PORT.
MONGODB_URI=mongodb+srv://...
JWT_SECRET=replace-with-a-secret-at-least-32-characters-long
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
# Optional — Gemini model for the quick-add fallback. Default: gemini-2.0-flash-lite.
# If you hit "limit: 0" 429s, pick a model that shows free-tier quota in Google AI Studio.
# GEMINI_MODEL=gemini-2.0-flash-lite
# Base URL of the deployment; used to build the OAuth callback + post-login redirect.
# Local: http://localhost:3000  ·  Prod: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Web Push (notifications). Generate with: npx web-push generate-vapid-keys
# Required only if you enable push reminders.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:you@example.com
# Vercel Cron auth — set in Vercel env; Vercel sends it as `Authorization: Bearer <CRON_SECRET>`.
# The /api/cron/* route fails CLOSED (401) if this is unset, so the cron won't run until set.
# Min 16 chars. Generate with: openssl rand -hex 24
# CRON_SECRET=
# Optional
# SENTRY_DSN=
